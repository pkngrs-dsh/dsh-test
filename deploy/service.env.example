# Copy outside the Git checkout and set file mode 0600.
# Replace example paths with the actual deployment layout.
FACE_APPEARANCE_PYTHON=/opt/faceappearance/env/bin/python
FACE_APPEARANCE_CONFIG=/opt/faceappearance/current/configs/stableLegacyService.json
FACE_APPEARANCE_COLMAP=/opt/faceappearance/colmap/bin/colmap
FACE_APPEARANCE_PUBLIC_BASE_URL=http://127.0.0.1:7860
FACE_APPEARANCE_TASK_ROOT=/opt/faceappearance/shared/tasks
FACE_APPEARANCE_HOST=127.0.0.1
FACE_APPEARANCE_PORT=7860
FACE_APPEARANCE_QUEUE_CAPACITY=2
CUDA_HOME=/usr/local/cuda-12.1
# For remote clients, replace the local base URL with your actual service origin,
# for example https://faceappearance.example.invalid (illustration only).
# signed: expiring OSS URL; public: only for objects already publicly readable.
FACE_APPEARANCE_OSS_RESULT_URL_MODE=signed
# Optional OSS settings: fill only in the external environment file.
# FACEV2_OSS_ACCESS_KEY_ID=
# FACEV2_OSS_ACCESS_KEY_SECRET=
# FACEV2_OSS_ENDPOINT=
# FACEV2_OSS_BUCKET=
